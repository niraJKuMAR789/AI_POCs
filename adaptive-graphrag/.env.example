# --- Model provider -------------------------------------------------------
# "nvidia" uses NVIDIA API Catalog / NIM (build.nvidia.com). "offline" runs a
# deterministic, dependency-free stack (used by CI and for keyless demos).
ATLAS_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Point at a self-hosted NIM instead of the hosted catalog:
# ATLAS_NVIDIA_BASE_URL=http://localhost:8000/v1

ATLAS_GENERATOR_MODEL=nvidia/nemotron-3-super-120b-a12b
ATLAS_FAST_MODEL=nvidia/nemotron-3-nano-30b-a3b
ATLAS_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
ATLAS_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2

# --- Storage ---------------------------------------------------------------
ATLAS_DATA_DIR=.atlas
# Leave empty for embedded Qdrant (on-disk under ATLAS_DATA_DIR).
ATLAS_QDRANT_URL=
# "networkx" (embedded, persisted to JSON) or "neo4j".
ATLAS_GRAPH_BACKEND=networkx
ATLAS_NEO4J_URI=bolt://localhost:7687
ATLAS_NEO4J_USER=neo4j
ATLAS_NEO4J_PASSWORD=atlas-password

# --- Web fallback (optional) -----------------------------------------------
TAVILY_API_KEY=
