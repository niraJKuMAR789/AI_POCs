AEGIS_PROVIDER=nvidia            # nvidia | openai_compatible | offline
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AEGIS_CLINICAL_MODEL=nvidia/nemotron-3-super-120b-a12b
AEGIS_CODING_MODEL=nvidia/nemotron-3-super-120b-a12b
AEGIS_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl
# Confidence an agent needs before its decision is applied without a human:
AEGIS_OVERRIDE_THRESHOLD=0.80
AEGIS_UPHOLD_THRESHOLD=0.70
