# nvidia | openai_compatible (e.g. vLLM serving the fine-tuned model) | offline
QUILL_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QUILL_BASE_URL=https://integrate.api.nvidia.com/v1
QUILL_SQL_MODEL=nvidia/nemotron-3-super-120b-a12b
QUILL_ANSWER_MODEL=nvidia/nemotron-3-nano-30b-a3b

# Serve the LoRA model with vLLM and point Quill at it:
# QUILL_PROVIDER=openai_compatible
# QUILL_BASE_URL=http://localhost:8000/v1
# QUILL_SQL_MODEL=quill-lora

# Production: bind API keys to roles/tenants (JSON). Empty = dev mode (role chosen by header).
# QUILL_API_PRINCIPALS={"key-analyst-1": {"role": "analyst"}, "key-clinic-7": {"role": "provider_portal", "context": {"provider_id": 7}}}
